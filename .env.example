# Copy this file to .env for local RustFS and live smoke testing.
# Start storage: docker compose up -d rustfs-init
# Stop storage: docker compose down
# Clean persisted objects: docker compose down && rm -rf .data/oss

RUSTFS_ACCESS_KEY=datalens-dev
RUSTFS_SECRET_KEY=datalens-dev-secret
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_ADDRESS=:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001

DATALENS_ETHEREUM_RPC_URL=replace-with-ethereum-rpc-url

DATALENS_S3_ENDPOINT_URL=http://localhost:9000
DATALENS_S3_BUCKET=datalens
DATALENS_S3_PREFIX=live-smoke
DATALENS_S3_REGION=auto
DATALENS_S3_FORCE_PATH_STYLE=true
DATALENS_RUN_S3_TESTS=1

DATALENS_DEFAULT_APPLICATION_TOKEN=replace-with-local-token
DATALENS_PUBLIC_APP_TOKEN=replace-with-public-app-token
DATALENS_METRICS_TOKEN=replace-with-metrics-token

AWS_ACCESS_KEY_ID=datalens-dev
AWS_SECRET_ACCESS_KEY=datalens-dev-secret
AWS_REGION=auto
