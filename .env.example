# Local PostgreSQL (docker compose)
DATALENS_PG_USER=datalens
DATALENS_PG_PASSWORD=datalens
DATALENS_PG_DB=datalens
DATALENS_PG_PORT=5432

DATABASE_URL=postgres://datalens:datalens@127.0.0.1:5432/datalens
DATALENS_DATABASE_URL=postgres://datalens:datalens@127.0.0.1:5432/datalens

# config/datalens.dev.toml
DATALENS_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# config/datalens.example.toml
DATALENS_METRICS_TOKEN=replace-with-metrics-token
DATALENS_DEGOV_LIVE_TOKEN=replace-with-degov-live-token
DATALENS_DEGOV_STG_TOKEN=replace-with-degov-stg-token
DATALENS_DEGOV_REALTIME_TOKEN=replace-with-degov-realtime-token
DATALENS_ORMP_TOKEN=replace-with-ormp-token
DATALENS_ARBITRUM_RPC_URL=
DATALENS_BASE_RPC_URL=
DATALENS_BSC_RPC_URL=
DATALENS_DARWINIA_RPC_URL=
DATALENS_LISK_RPC_URL=
DATALENS_OPTIMISM_RPC_URL=
