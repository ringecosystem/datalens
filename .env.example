# RustFS / S3-compatible object storage
RUSTFS_ACCESS_KEY=datalens-dev
RUSTFS_SECRET_KEY=datalens-dev-secret
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_ADDRESS=:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# PostgreSQL test storage
DATALENS_POSTGRES_TEST_USER=datalens
DATALENS_POSTGRES_TEST_PASSWORD=datalens
DATALENS_POSTGRES_TEST_DB=datalens_test
DATALENS_POSTGRES_TEST_PORT=5432
DATALENS_POSTGRES_TEST_URL=postgres://datalens:datalens@127.0.0.1:5432/datalens_test

# Datalens server
DATALENS_S3_ENDPOINT_URL=http://localhost:9000
DATALENS_S3_INTERNAL_ENDPOINT_URL=http://rustfs:9000
DATALENS_S3_BUCKET=datalens
DATALENS_S3_PREFIX=local-compose
DATALENS_S3_REGION=auto
DATALENS_S3_FORCE_PATH_STYLE=true
DATALENS_RUN_S3_TESTS=1

DATALENS_IMAGE=datalens:local
DATALENS_SERVER_CONFIG=/etc/datalens/datalens.toml
DATALENS_SERVER_BIND=0.0.0.0:3000
DATALENS_SERVER_PORT=3000

# Auth tokens
DATALENS_DEFAULT_APPLICATION_TOKEN=replace-with-local-token
DATALENS_PUBLIC_APP_TOKEN=replace-with-public-app-token
DATALENS_METRICS_TOKEN=replace-with-metrics-token

# Live smoke RPCs
DATALENS_ETHEREUM_RPC_URL=http://host.docker.internal:8545
DATALENS_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DATALENS_TRON_RPC_URL=https://api.trongrid.io
DATALENS_TRONGRID_API_KEY=

# Optional Datalens client examples
DATALENS_ORMP_TOKEN=replace-with-local-token
DATALENS_ENDPOINT=http://127.0.0.1:3000
DATALENS_APPLICATION=token-sdk-typescript
DATALENS_TOKEN=replace-with-application-token
DATALENS_LIVE_SMOKE_TOKEN=replace-with-live-smoke-token

# Optional external application index service examples
# Replace this with the external application's public index GraphQL endpoint.
DATALENS_INDEX_GRAPHQL_URL=http://127.0.0.1:3000/index/graphql
DATALENS_INDEX_DATABASE_URL=postgres://datalens:datalens@127.0.0.1:5432/datalens_test
DATALENS_ETHEREUM_FROM_BLOCK=19000000
DATALENS_ETHEREUM_TO_BLOCK=19000010
DATALENS_ETHEREUM_FIRST=10
DATALENS_SOLANA_FROM_SLOT=250000000
DATALENS_SOLANA_TO_SLOT=250000003
DATALENS_TRON_FROM_BLOCK=83200000
DATALENS_TRON_TO_BLOCK=83200002

AWS_ACCESS_KEY_ID=datalens-dev
AWS_SECRET_ACCESS_KEY=datalens-dev-secret
AWS_REGION=auto
